; Far Horizon is a separate Godot project; the existing Earth demo is preserved.
config_version=5

[application]
config/name="The Far Horizon — GM Visual Aid"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="A GM-operated classroom visual adventure. Sessions 1–3."

[display]
window/size/viewport_width=1366
window/size/viewport_height=768
window/size/window_width_override=1366
window/size/window_height_override=768
window/stretch/mode="canvas_items"

[rendering]
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=1024
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.018, 0.035, 0.05, 1)

[audio]
driver/enable_input=false

[physics]
common/physics_ticks_per_second=60
